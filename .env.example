# Path to the SQLite database file (inside the container: /data/retail.db)
DATABASE_PATH=data/retail.db
# How many sales a single backfill batch stages
BACKFILL_BATCH_SIZE=500
# Background worker that advances/completes backfill tasks
WORKER_ENABLED=true
WORKER_POLL_INTERVAL=0.25
WORKER_MAX_STEPS_PER_CYCLE=200
